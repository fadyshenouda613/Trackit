# Copy to .env for development. A deployment sets these itself; an exported
# variable always beats the file.

# Postgres. docker-compose.yml in this directory serves exactly this one.
DATABASE_URL=postgres://trackit:trackit@localhost:5433/trackit

# Signs the access tokens. At least 32 characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=4000
NODE_ENV=development

# How long an access token lives (seconds) and how long a machine may stay
# away before it has to sign in again (days). Every refresh extends the latter.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=90

# Comma-separated browser origins allowed to call the API. Empty allows none.
# The desktop app calls from its main process, which is not a browser, and
# needs no entry.
CORS_ORIGINS=

# 1 behind Railway, Render or any proxy that sets X-Forwarded-For, so the
# rate limiter keys on the real address rather than the proxy's.
TRUST_PROXY=0

# Attempts per address on /auth/register, /auth/login and /auth/refresh
# within the window.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
