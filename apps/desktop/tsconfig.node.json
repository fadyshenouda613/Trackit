{
  "include": ["electron.vite.config.ts", "tooling/**/*", "src/main/**/*", "src/preload/**/*", "../../packages/shared/src/**/*"],
  "exclude": ["../../packages/shared/src/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  }
}
