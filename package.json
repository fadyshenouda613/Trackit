{
  "name": "trackit",
  "version": "0.1.0",
  "description": "Trackit - freelance time and billing",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @trackit/desktop",
    "build": "npm run build --workspace @trackit/desktop",
    "start": "npm run start --workspace @trackit/desktop",
    "seed": "npm run seed --workspace @trackit/desktop --",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tests/sync/tsconfig.json",
    "test": "vitest run",
    "test:sync": "vitest run --config tests/sync/vitest.config.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^5.0.0"
  }
}
